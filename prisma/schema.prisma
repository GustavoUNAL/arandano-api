  siteId       String?   @map("site_id")
  site         DentalSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  expenseDate  DateTime  @map("expense_date") @db.Date
  concept      String
  provider     String?
  expenseType  String?   @map("expense_type")
  amount       Decimal   @db.Decimal(14, 2)
  status       String    @default("Registrado")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([companyId, expenseDate], map: "idx_dental_expenses_company_date")
  @@map("dental_expenses")
}

