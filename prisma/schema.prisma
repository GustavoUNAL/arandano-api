// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id         String      @id @default(cuid())
  companyId  String?     @map("company_id")
  company    Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  userId     String?     @map("user_id")
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     AuditAction
  tableName  String      @map("table_name")
  recordId   String?     @map("record_id")
  oldValues  Json?       @map("old_values") @db.JsonB
  newValues  Json?       @map("new_values") @db.JsonB
  ipAddress  String?     @map("ip_address")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([companyId], map: "idx_audit_logs_company_id")
  @@index([userId], map: "idx_audit_logs_user_id")
  @@index([tableName], map: "idx_audit_logs_table_name")
  @@index([createdAt], map: "idx_audit_logs_created_at")
  @@index([companyId, createdAt], map: "idx_audit_logs_company_created")
  @@map("audit_logs")
}
